{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flutter Web (Firefox / Web Server)",
      "request": "launch",
      "type": "dart",
      "args": [
        "-d",
        "web-server",
        "--web-hostname",
        "localhost",
        "--web-port",
        "8090"
      ]
    },
    {
      "name": "Flutter Web (Edge)",
      "request": "launch",
      "type": "dart",
      "deviceId": "edge"
    },
    {
      "name": "Flutter Web (Chrome)",
      "request": "launch",
      "type": "dart",
      "deviceId": "chrome"
    }
  ]
}
